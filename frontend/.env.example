# ============================================================
# SafeChat Frontend — Environment Variables
# Copy to frontend/.env and fill in real values. Never commit .env.
#
# Loaded via flutter_dotenv (see lib/main.dart). pubspec.yaml lists .env as
# a Flutter asset, so the file must exist (even empty) for `flutter analyze`
# / `flutter test` / builds to succeed — CI creates an empty one via
# `touch .env` (see .github/workflows/flutter-ci.yml).
# ============================================================

# ---- Backend -----------------------------------------------------
# Base URL of the SafeChat backend API (see backend/.env.example — that's
# the project this URL must actually be serving).
# Defaults to http://10.0.2.2:8000 (Android emulator's alias for the host
# machine's localhost) if unset — override for a physical device, iOS
# simulator, web, or a deployed backend.
API_BASE_URL=http://10.0.2.2:8000

# ---- Firebase client config (NOT env-driven) ----------------------
# Firebase Web/Android/iOS config (apiKey, appId, messagingSenderId,
# storageBucket, projectId, authDomain) is generated into
# lib/firebase_options.dart by `flutterfire configure` and compiled into the
# app — it is intentionally not read from this .env file. Re-run
# `flutterfire configure` to point the app at a different Firebase project,
# and make sure it's the same project as backend/.env's GCP_PROJECT_ID.
